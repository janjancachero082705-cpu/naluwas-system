@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
(function () {
    'use strict';

    var CHURCH  = @json(auth()->user()->church->name ?? 'My Church');
    var MONTHS  = @json($months ?? []);
    var INCOME  = @json($incomeData ?? []);
    var EXPENSE = @json($expenseData ?? []);
    var PESO    = '\u20B1';
    var chart   = null;

    function css(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
    function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
    function fileBase() { return CHURCH.replace(/[^a-zA-Z0-9]/g, '_') + '_Report_' + new Date().toISOString().slice(0, 10); }


    /* ---------------- CHART ---------------- */
    function buildChart() {
        var canvas = document.getElementById('financeChart');
        if (!canvas || !window.Chart) return;
        if (!MONTHS.length) {
            canvas.parentNode.innerHTML = '<div class="f-empty"><p>No chart data available</p></div>';
            return;
        }
        if (chart) chart.destroy();

        var grid = css('--border-color'), tick = css('--text-muted');

        function line(label, data, color, dashed) {
            return {
                label: label, data: data, borderColor: color, backgroundColor: color + '14',
                borderWidth: 2.5, borderDash: dashed ? [5, 4] : [], fill: true, tension: 0.4,
                pointRadius: 3, pointBackgroundColor: color,
                pointBorderColor: css('--bg-card'), pointBorderWidth: 2, pointHoverRadius: 5
            };
        }

        chart = new Chart(canvas, {
            type: 'line',
            data: { labels: MONTHS, datasets: [line('Income', INCOME, '#22C55E', false), line('Expenses', EXPENSE, '#EF4444', true)] },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { intersect: false, mode: 'index' },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: css('--bg-card'), titleColor: css('--text-main'), bodyColor: tick,
                        borderColor: grid, borderWidth: 1, cornerRadius: 8, padding: 10,
                        callbacks: { label: function (c) { return c.dataset.label + ': ' + PESO + c.parsed.y.toLocaleString(); } }
                    }
                },
                scales: {
                    y: { beginAtZero: true, grid: { color: grid }, ticks: { color: tick, font: { size: 10 }, callback: function (v) { return PESO + v.toLocaleString(); } } },
                    x: { grid: { display: false }, ticks: { color: tick, font: { size: 10 } } }
                }
            }
        });
    }

    buildChart();
    window.addEventListener('themechanged', buildChart);   // fired by app-shell.js


    /* ---------------- EXPORT ---------------- */
    var RULES = [
        ['#stats-section', 'display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:0'],
        ['#stats-section > div', 'width:auto;max-width:none;padding:0;margin:0'],
        ['.stat-card', 'background:#fff;border:1px solid #ddd;border-radius:8px;padding:12px;height:100%'],
        ['.stat-icon', 'display:none'],
        ['.stat-label', 'font-size:10px;text-transform:uppercase;color:#666'],
        ['.stat-value', 'font-size:20px;font-weight:700;color:#111'],
        ['.stat-trend', 'font-size:11px;color:#666'],
        ['.panel', 'background:#fff;border:1px solid #ddd;border-radius:8px;margin:14px 0;break-inside:avoid'],
        ['.panel-head', 'padding:10px 14px;font-weight:700;border-bottom:1px solid #ddd'],
        ['.panel-body', 'padding:14px'],
        ['table', 'width:100%;border-collapse:collapse'],
        ['th', 'border-bottom:1px solid #eee;padding:6px;text-align:left;font-size:12px;color:#444'],
        ['td', 'border-bottom:1px solid #eee;padding:6px;text-align:left;font-size:12px;color:#111'],
        ['.text-end', 'text-align:right!important'],
        ['.f-income', 'color:#16a34a'],
        ['.f-expense', 'color:#dc2626'],
        ['.f-list-item', 'display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #eee;font-size:12px;color:#111'],
        ['.f-legend', 'display:none'],
        ['.f-pill i', 'display:none'],
        ['.f-pill', 'font-size:11px'],
        ['.f-chart img', 'max-width:100%'],
        ['.f-empty', 'text-align:center;color:#999;padding:12px'],
        ['.text-muted', 'color:#666']
    ];

    function styles(prefix) {
        return RULES.map(function (r) { return prefix + r[0] + '{' + r[1] + '}'; }).join('');
    }

    function selectedHtml() {
        var html = '';
        document.querySelectorAll('#exportModal [data-section]:checked').forEach(function (cb) {
            var el = document.getElementById(cb.dataset.section);
            if (!el) return;
            var clone = el.cloneNode(true);
            clone.querySelectorAll('.no-print').forEach(function (n) { n.remove(); });
            clone.querySelectorAll('canvas').forEach(function (c) {
                if (chart) {
                    var img = new Image();
                    img.src = chart.toBase64Image();
                    c.replaceWith(img);
                } else { c.remove(); }
            });
            html += clone.outerHTML;
        });
        return html;
    }

    function reportHtml() {
        return '<div style="text-align:center;border-bottom:2px solid #333;margin-bottom:16px;padding-bottom:8px;">' +
                   '<h2>' + esc(CHURCH) + '</h2>' +
                   '<p>Reports &amp; Analytics - ' + new Date().toLocaleDateString() + '</p>' +
               '</div>' + selectedHtml() +
               '<p style="text-align:center;font-size:10px;margin-top:16px;border-top:1px solid #ccc;padding-top:8px;">' +
               'Generated by TINC Church Management System | ' + new Date().toLocaleString() + '</p>';
    }

    function doPrint() {
        var w = window.open('', '_blank');
        w.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>' + esc(CHURCH) + ' Report</title><style>' +
            'body{font-family:Arial,sans-serif;margin:24px;color:#111}' + styles('') +
            '</style></head><body>' + reportHtml() + '</body></html>');
        w.document.close();
        w.focus();
        w.print();
    }

    function doPdf() {
        var el = document.createElement('div');
        el.id = 'pdfRoot';
        el.style.cssText = 'background:#fff;color:#111;padding:20px;font-family:Arial,sans-serif;';
        el.innerHTML = '<style>' + styles('#pdfRoot ') + '</style>' + reportHtml();
        html2pdf().set({
            margin: 0.5, filename: fileBase() + '.pdf',
            image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2, backgroundColor: '#ffffff' },
            jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
        }).from(el).save();
    }

    var btnPrint = document.getElementById('exportPrint');
    var btnPdf   = document.getElementById('exportPdf');

    function syncButtons() {
        var none = document.querySelectorAll('#exportModal [data-section]:checked').length === 0;
        btnPrint.disabled = none;
        btnPdf.disabled   = none;
    }
    document.querySelectorAll('#exportModal [data-section]').forEach(function (cb) { cb.addEventListener('change', syncButtons); });

    function closeModal() {
        var modal = bootstrap.Modal.getInstance(document.getElementById('exportModal'));
        if (modal) modal.hide();
    }
    btnPrint.addEventListener('click', function () { closeModal(); doPrint(); });
    btnPdf.addEventListener('click',   function () { closeModal(); doPdf(); });

    window.addEventListener('localeChanged', function () {
        if (typeof window.applyTranslations === 'function') window.applyTranslations();
    });
})();
</script>
@endpush