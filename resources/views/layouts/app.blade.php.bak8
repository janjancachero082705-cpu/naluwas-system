    {{-- Apply saved theme before paint (prevents a light-mode flash) --}}
    <script>
        (function () {
            try {
                if (localStorage.getItem('theme') === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (e) {}
        })();
    </script>

    {{-- Keep Bootstrap 5.3 components in sync with the app theme --}}
    <script>
        (function () {
            var r = document.documentElement;
            function s() { r.setAttribute('data-bs-theme', r.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'); }
            s();
            new MutationObserver(s).observe(r, { attributes: true, attributeFilter: ['data-theme'] });
        })();
    </script>

