                </div>
            @endif
        </div>
        <script>
            setTimeout(function () {
                document.querySelectorAll('#toastStack .toast').forEach(function (t) {
                    t.classList.add('leaving');
                    setTimeout(function () { t.remove(); }, 320);
                });
            }, 4500);
        </script>
