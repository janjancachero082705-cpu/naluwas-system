    {{-- Header profile menu (registered before app-shell.js so it takes the click first) --}}
    <script>
        (function () {
            var u = document.getElementById('headerUser'), m = document.getElementById('headerMenu'), w = document.getElementById('headerUserWrap');
            if (!u || !m) return;
            function set(o) { m.classList.toggle('open', o); u.setAttribute('aria-expanded', o ? 'true' : 'false'); }
            u.addEventListener('click', function (e) { e.stopImmediatePropagation(); e.stopPropagation(); set(!m.classList.contains('open')); }, true);
            u.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); set(!m.classList.contains('open')); } });
            document.addEventListener('click', function (e) { if (!w.contains(e.target)) set(false); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
            document.getElementById('hmTheme').addEventListener('click', function () { set(false); var t = document.getElementById('themeToggleBtn'); if (t) t.click(); });
        })();
    </script>

    {{-- Scripts --}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ $assetPath('js/app-shell.js') }}"></script>
        <script src="{{ $assetPath('js/app-motion.js') }}"></script>
    <script src="{{ $assetPath('js/app-mobile-fix.js') }}"></script>
    @stack('scripts')

    {{-- Keep Chart.js text/grid readable in dark mode --}}
    <script>
        (function () {
            function sync() {
                if (!window.Chart) return;
                var dark = document.documentElement.getAttribute('data-theme') === 'dark';
                var txt = dark ? '#C9CFF0' : '#5F6A98', grid = dark ? 'rgba(255,255,255,.09)' : 'rgba(16,27,74,.07)';
                try { Chart.defaults.color = txt; Chart.defaults.borderColor = grid; } catch (e) {}
                try {
                    Object.keys(Chart.instances || {}).forEach(function (k) {
                        var c = Chart.instances[k], o = c.options || {};
                        Object.keys(o.scales || {}).forEach(function (a) {
                            var sc = o.scales[a]; sc.ticks = sc.ticks || {}; sc.grid = sc.grid || {};
                            sc.ticks.color = txt; if (sc.type !== 'radialLinear') sc.grid.color = grid;
                        });
                        if (o.plugins && o.plugins.legend) { o.plugins.legend.labels = o.plugins.legend.labels || {}; o.plugins.legend.labels.color = txt; }
                        c.update('none');
                    });
                } catch (e) {}
            }
            window.addEventListener('load', function () { setTimeout(sync, 400); });
            new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
        })();
    </script>
</body>
</html>

