    // Root-relative URLs work on any host/scheme (dev tunnels, proxies, sub-folders)
    $assetPath      = fn ($p) => parse_url(asset($p), PHP_URL_PATH);
    $user           = Auth::user();
    $churchSettings = \App\Models\ChurchSetting::current();

    $unreadMsgCount = 0;
    if ($user && $user->church_id) {
        try {
            if (class_exists(\App\Models\Message::class)) {
                $unreadMsgCount = \App\Models\Message::where('receiver_church_id', $user->church_id)
                    ->where('is_read', false)
                    ->count();
            }
        } catch (\Throwable $e) {}
    }
