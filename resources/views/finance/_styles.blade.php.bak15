<style>
    /* ---- stat cards (extends .stat-card from app-shell) ---- */
    .f-stat { display: flex; align-items: center; gap: 14px; }
    .f-stat .stat-trend.trend-up   { color: #16a34a; }
    .f-stat .stat-trend.trend-down { color: #dc2626; }

    /* ---- income / expense colours ---- */
    .f-income  { color: #16a34a; }
    .f-expense { color: #dc2626; }

    /* ---- pills ---- */
    .f-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-size: .75rem; font-weight: 600;
              background: var(--bg-hover); border: 1px solid var(--border-color); color: var(--text-muted); }
    .f-pill.income  { background: rgba(34,197,94,.12); border-color: rgba(34,197,94,.35); color: #16a34a; }
    .f-pill.expense { background: rgba(239,68,68,.12); border-color: rgba(239,68,68,.35); color: #dc2626; }

    /* ---- selected church mini stats ---- */
    .f-mini { background: var(--bg-hover); border: 1px solid var(--border-color); border-radius: 12px; padding: 14px 16px; height: 100%; }
    .f-mini-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--text-muted); margin-bottom: 4px; }
    .f-mini-value { font-size: 1.4rem; font-weight: 700; }

    .f-subtitle { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); margin-bottom: 10px; }
    .f-tags { display: flex; flex-wrap: wrap; gap: 8px; }

    /* ---- all-churches cards ---- */
    .f-church-name { font-weight: 700; font-size: .95rem; color: var(--text-main); }
    .f-church-name i { color: var(--primary); margin-right: 6px; }
    .f-church-balance { font-size: 1.7rem; font-weight: 800; margin: 12px 0; }

    /* ---- chart ---- */
    .f-chart { position: relative; height: 320px; }
    .f-legend { display: flex; gap: 18px; font-size: .78rem; color: var(--text-muted); margin-bottom: 10px; }
    .f-legend span { display: inline-flex; align-items: center; gap: 6px; }
    .f-legend i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .f-legend i.income  { background: #22C55E; }
    .f-legend i.expense { background: #EF4444; }

    /* ---- category lists ---- */
    .f-list-item { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--border-color); font-size: .85rem; }
    .f-list-total { display: flex; justify-content: space-between; padding-top: 12px; margin-top: 4px; font-weight: 700; font-size: .9rem; }
    .f-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }
    .f-dot.income  { background: #22C55E; }
    .f-dot.expense { background: #EF4444; }

    /* ---- empty state ---- */
    .f-empty { text-align: center; padding: 40px 16px; color: var(--text-muted); }
    .f-empty i { font-size: 2rem; opacity: .5; margin-bottom: 10px; display: block; }
    .f-empty h5 { font-size: 1rem; font-weight: 700; color: var(--text-main); margin-bottom: 4px; }
    .f-empty p { font-size: .82rem; margin: 0; }

    /* ---- create form ---- */
    .m-narrow { max-width: 640px; }
    .req { color: #dc2626; }
    .f-foot { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color); }

    @@media print { .no-print { display: none !important; } }
</style>
