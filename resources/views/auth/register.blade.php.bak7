    $step1Err = $errors->has('church_name') || $errors->has('subdomain') || $errors->has('denomination');
    $step2Err = $errors->has('name') || $errors->has('email') || $errors->has('password');
    $startStep = ($step2Err && ! $step1Err) ? 2 : 1;
