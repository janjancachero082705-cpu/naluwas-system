<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>Register — TINC Church System</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-body: #F4F5FE;
            --card-bg: #FFFFFF;
            --primary: #6C5DD3;
            --primary-hover: #5A4BCA;
            --primary-soft: #F0EEFF;
            --text-main: #1A1A1A;
            --text-muted: #7A7A7A;
            --border: #F0F0F0;
        }

        [data-theme="dark"] {
            --bg-body: #13111C;
            --card-bg: #1C1A27;
            --primary: #8A7DFF;
            --primary-hover: #9F94FF;
            --primary-soft: rgba(138, 125, 255, 0.1);
            --text-main: #FFFFFF;
            --text-muted: #A09EB0;
            --border: #2D2A3E;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background: var(--bg-body);
            background-image: radial-gradient(circle at top right, rgba(108, 93, 211, 0.08) 0%, transparent 40%);
            font-family: 'Poppins', sans-serif;
            color: var(--text-main);
            transition: background 0.3s ease;
        }

        .auth-wrap {
            width: 100%;
            max-width: 1050px;
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            background: var(--card-bg);
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(108, 93, 211, 0.15);
            border: 1px solid var(--border);
        }

        /* FORM PANEL */
        .left-panel {
            padding: 2.5rem 3rem;
            overflow-y: auto;
            max-height: 90vh;
        }
        .left-panel::-webkit-scrollbar { width: 6px; }
        .left-panel::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }

        .form-head h2 { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.5rem; color: var(--text-main); }
        .form-head p { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.5rem; }

        .section-label {
            font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 1px; color: var(--primary); margin-top: 1.5rem; margin-bottom: 1rem;
            display: flex; align-items: center; gap: 8px;
        }

        .field { margin-bottom: 1rem; }
        .field label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--text-main); }
        .input-wrap { position: relative; }
        .input-wrap i { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem; }
        .input-wrap input {
            width: 100%; padding: 0.75rem 2.5rem 0.75rem 2.75rem;
            border: 1px solid var(--border); border-radius: 12px;
            background: var(--bg-body); font-family: inherit; font-size: 0.9rem;
            color: var(--text-main); transition: all 0.2s ease;
        }
        .input-wrap input:focus { outline: none; background: var(--card-bg); border-color: var(--primary); box-shadow: 0 0 0 4px var(--primary-soft); }

        .btn-submit {
            width: 100%; padding: 0.9rem; margin-top: 1.5rem;
            border: none; border-radius: 12px; background: var(--primary);
            color: #fff; font-weight: 600; font-size: 1rem; cursor: pointer;
            transition: all 0.2s; display: flex; justify-content: center; align-items: center; gap: 8px;
            box-shadow: 0 8px 20px rgba(108, 93, 211, 0.3);
        }
        .btn-submit:hover { background: var(--primary-hover); transform: translateY(-2px); }

        .form-footer { text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted); }
        .form-footer a { color: var(--primary); font-weight: 600; text-decoration: none; }

        /* RIGHT PANEL (BRANDING) */
        .right-panel {
            background: linear-gradient(160deg, #6C5DD3 0%, #4B3BB3 100%);
            padding: 3rem 2rem; display: flex; flex-direction: column;
            justify-content: center; align-items: center; text-align: center;
            color: #fff; position: relative; overflow: hidden;
        }
        .right-panel::before {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(circle at center, rgba(255,255,255,0.15) 0%, transparent 70%);
        }

        .logo-container { position: relative; margin-bottom: 2rem; z-index: 1; }
        .logo-image {
            width: 120px; height: 120px; border-radius: 50%; object-fit: cover;
            border: 4px solid rgba(255,255,255,0.3);
            box-shadow: 0 0 40px rgba(255,255,255,0.2);
        }
        .logo-fallback {
            width: 120px; height: 120px; border-radius: 50%;
            background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center;
            font-size: 3rem; border: 4px solid rgba(255,255,255,0.3);
        }

        .church-name { font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; z-index: 1; }
        .church-name span { color: #FCD34D; }
        .church-tagline { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 3px; opacity: 0.8; margin-top: 0.5rem; z-index: 1; }

        .divider-line { width: 60px; height: 3px; background: rgba(255,255,255,0.4); margin: 2rem auto; border-radius: 3px; z-index: 1; }

        .panel-verse { max-width: 280px; z-index: 1; }
        .verse-text { font-size: 0.95rem; font-style: italic; line-height: 1.6; margin-bottom: 0.5rem; }
        .verse-ref { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; }

        /* Alert */
        .alert-box { padding: 0.8rem 1rem; border-radius: 12px; font-size: 0.85rem; margin-bottom: 1.5rem; font-weight: 500; }
        .alert-box.error { background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; }

        @media (max-width: 860px) {
            .auth-wrap { grid-template-columns: 1fr; max-width: 500px; }
            .right-panel { display: none; }
            .left-panel { padding: 2rem; }
        }
    </style>
</head>
<body>

<div class="auth-wrap">
    <!-- FORM -->
    <div class="left-panel">
        <div class="form-head">
            <h2>Create an Account</h2>
            <p>Register your church and start managing today.</p>
        </div>

        @if($errors->any())
            <div class="alert-box error">
                <i class="fas fa-exclamation-circle"></i> {{ $errors->first() }}
            </div>
        @endif

        <form method="POST" action="{{ route('register') }}" id="registerForm">
            @csrf

            <!-- Church Info -->
            <div class="section-label"><i class="fas fa-building"></i> Church Information</div>
            
            <div class="field">
                <label>Church Name *</label>
                <div class="input-wrap">
                    <i class="fas fa-church"></i>
                    <input type="text" name="church_name" value="{{ old('church_name') }}" required placeholder="Naluwas Church">
