                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">
                    URL: <span id="subdomainPreview" style="color: var(--primary); font-weight: 600;">yourchurch</span>.churchsystem.com
                </div>
            </div>

            <div class="field">
                <label>Denomination</label>
                <div class="input-wrap">
                    <i class="fas fa-tag"></i>
                    <input type="text" name="denomination" value="{{ old('denomination') }}" placeholder="e.g., Iglesia Ni Cristo">
                </div>
            </div>

            <!-- Admin Info -->
            <div class="section-label"><i class="fas fa-user-shield"></i> Admin Account</div>

            <div class="field">
                <label>Full Name *</label>
                <div class="input-wrap">
                    <i class="fas fa-user"></i>
                    <input type="text" name="name" value="{{ old('name') }}" required placeholder="John Doe">
                </div>
            </div>

            <div class="field">
                <label>Email Address *</label>
                <div class="input-wrap">
                    <i class="fas fa-envelope"></i>
                    <input type="email" name="email" value="{{ old('email') }}" required placeholder="admin@yourchurch.com">
                </div>
            </div>

            <div class="field">
                <label>Password *</label>
                <div class="input-wrap">
                    <i class="fas fa-lock"></i>
                    <input type="password" name="password" id="password" required placeholder="••••••••">
                </div>
            </div>

            <div class="field">
                <label>Confirm Password *</label>
                <div class="input-wrap">
                    <i class="fas fa-lock"></i>
                    <input type="password" name="password_confirmation" id="passwordConfirm" required placeholder="••••••••">
                </div>
            </div>

            <button type="submit" class="btn-submit" id="registerBtn">
                Create Account <i class="fas fa-arrow-right"></i>
            </button>

            <div class="form-footer">
                Already have an account? <a href="{{ route('login') }}">Sign In</a>
            </div>
        </form>
    </div>

    <!-- BRANDING -->
    <div class="right-panel">
        <div class="logo-container">
            @if(file_exists(public_path('images/logo1.png')))
                <img src="{{ asset('images/logo1.png') }}" alt="Church Logo" class="logo-image">
            @else
                <div class="logo-fallback"><i class="fas fa-church"></i></div>
            @endif
        </div>

        <div class="church-name">TINC <span>Church</span></div>
        <div class="church-tagline">Management System</div>
        
        <div class="divider-line"></div>

        <div class="panel-verse">
            <div class="verse-text">"I am the way and the truth and the life."</div>
            <div class="verse-ref">John 14:6</div>
        </div>
    </div>
</div>

<script>
    // Subdomain Preview
    const subdomainInput = document.getElementById('subdomainInput');
    const subdomainPreview = document.getElementById('subdomainPreview');
    if (subdomainInput) {
        subdomainInput.addEventListener('input', function() {
            const val = this.value.toLowerCase().replace(/[^a-z0-9-]/g, '');
            this.value = val;
            subdomainPreview.textContent = val || 'yourchurch';
        });
    }

    // Submit Loader
    document.getElementById('registerForm').addEventListener('submit', function() {
        const btn = document.getElementById('registerBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating...';
        btn.style.opacity = '0.7';
    });
</script>

</body>
</html>