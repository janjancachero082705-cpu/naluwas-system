(function () {
    var busy = false;
    function fit() {
        if (busy || !window.Chart || !Chart.instances) return;
        busy = true;
        requestAnimationFrame(function () {
            Object.keys(Chart.instances).forEach(function (k) {
                try { Chart.instances[k].resize(); } catch (e) {}
            });
            busy = false;
        });
    }
    window.addEventListener('load', function () {
        [50, 300, 800, 1500].forEach(function (t) { setTimeout(fit, t); });
        if ('ResizeObserver' in window) {
            document.querySelectorAll('.income-chart, .donut-wrap').forEach(function (el) {
                new ResizeObserver(fit).observe(el);
            });
        }
    });
    window.addEventListener('resize', fit);
    window.addEventListener('orientationchange', function () { setTimeout(fit, 250); });
})();
/* mKebab: members actions dropdown (mobile) */
(function () {
    var mq = window.matchMedia('(max-width: 767.98px)');
    var current = null;

    function closeAll() {
        document.querySelectorAll('.m-actions.m-open').forEach(function (m) {
            m.classList.remove('m-open');
            m.style.top = ''; m.style.left = ''; m.style.right = '';
        });
        document.querySelectorAll('.m-kebab[aria-expanded="true"]').forEach(function (b) {
            b.setAttribute('aria-expanded', 'false');
        });
        current = null;
    }

    function open(btn, menu) {
        closeAll();
        menu.classList.add('m-open');
        btn.setAttribute('aria-expanded', 'true');
        current = menu;

        var r = btn.getBoundingClientRect();
        var h = menu.offsetHeight;
        var top = r.bottom + 6;
        if (top + h > window.innerHeight - 8) top = Math.max(8, r.top - h - 6);
        menu.style.top = top + 'px';
        menu.style.right = Math.max(10, window.innerWidth - r.right) + 'px';
        menu.style.left = 'auto';
    }

    function build() {
        document.querySelectorAll('tr[data-row] .m-actions').forEach(function (menu) {
            if (menu.previousElementSibling && menu.previousElementSibling.classList.contains('m-kebab')) return;
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'm-kebab';
            btn.setAttribute('aria-label', 'Actions');
            btn.setAttribute('aria-haspopup', 'true');
            btn.setAttribute('aria-expanded', 'false');
            btn.innerHTML = '<i class="fas fa-ellipsis-vertical"></i>';
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (menu.classList.contains('m-open')) closeAll(); else open(btn, menu);
            });
            menu.parentNode.insertBefore(btn, menu);
            // Isira ang menu human pislita ang usa ka action (ang action mismo mo-run gihapon)
            menu.addEventListener('click', function () { setTimeout(closeAll, 0); });
        });
    }

    document.addEventListener('DOMContentLoaded', build);
    if (document.readyState !== 'loading') build();

    document.addEventListener('click', function (e) {
        if (current && !current.contains(e.target)) closeAll();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
    window.addEventListener('scroll', function () { if (current) closeAll(); }, { passive: true });
    window.addEventListener('resize', closeAll);
    if (mq.addEventListener) mq.addEventListener('change', closeAll);
})();