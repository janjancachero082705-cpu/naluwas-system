/* =====================================================================
   auth.css - login + register
===================================================================== */
:root{
  --bg:#F3F2FB; --card:#FFFFFF; --ink:#17152B; --muted:#6F6C85; --line:#E7E5F3;
  --primary:#6C5DD3; --primary-2:#4B3BB3; --primary-soft:#F0EEFF; --gold:#F5B544;
  --danger:#DC2626; --danger-soft:#FEF2F2; --ok:#16A34A;
  --ease:cubic-bezier(.2,.7,.2,1);
}
[data-theme="dark"]{
  --bg:#0F0D1A; --card:#181526; --ink:#F4F3FF; --muted:#A09EB8; --line:#2A2740;
  --primary:#8A7DFF; --primary-2:#5B4BD6; --primary-soft:rgba(138,125,255,.14);
  --danger-soft:rgba(220,38,38,.12);
}
*{ margin:0; padding:0; box-sizing:border-box; }
html{ -webkit-text-size-adjust:100%; }
body{
  min-height:100vh; display:grid; place-items:center; padding:1.25rem;
  background:var(--bg); color:var(--ink);
  font-family:'Plus Jakarta Sans',system-ui,sans-serif; -webkit-font-smoothing:antialiased;
}
*:focus-visible{ outline:2px solid var(--primary); outline-offset:2px; }

.auth{
  width:100%; max-width:1120px; min-height:680px; display:grid; grid-template-columns:minmax(0,5fr) minmax(0,6fr);
  background:var(--card); border:1px solid var(--line); border-radius:32px; overflow:hidden;
  box-shadow:0 30px 80px rgba(75,59,179,.18);
}
.auth.reverse{ grid-template-columns:minmax(0,6fr) minmax(0,5fr); }

/* ---------- Form side ---------- */
.form-side{ padding:2.75rem 3rem; display:flex; flex-direction:column; justify-content:center; position:relative; max-height:92vh; overflow-y:auto; }
.form-side::-webkit-scrollbar{ width:6px; } .form-side::-webkit-scrollbar-thumb{ background:var(--line); border-radius:9px; }
.topline{ display:flex; align-items:center; justify-content:space-between; margin-bottom:2.2rem; }
.mini-brand{ display:flex; align-items:center; gap:.7rem; font-weight:800; font-size:1rem; letter-spacing:-.01em; }
.mini-brand .mark{ width:38px; height:38px; border-radius:12px; display:grid; place-items:center; color:#fff; background:linear-gradient(135deg,var(--primary),var(--primary-2)); box-shadow:0 8px 18px rgba(108,93,211,.35); }
.theme-btn{ width:40px; height:40px; border-radius:12px; border:1px solid var(--line); background:transparent; color:var(--muted); cursor:pointer; transition:all .18s var(--ease); }
.theme-btn:hover{ color:var(--primary); border-color:var(--primary); background:var(--primary-soft); }
.form-side h1{ font-size:2rem; font-weight:800; letter-spacing:-.03em; line-height:1.15; margin-bottom:.55rem; }
.form-side .lead{ color:var(--muted); font-size:.95rem; line-height:1.6; max-width:42ch; margin-bottom:1.8rem; }

.alert{ display:flex; gap:.7rem; align-items:flex-start; padding:.9rem 1rem; margin-bottom:1.3rem; border-radius:14px; font-size:.86rem; font-weight:600; background:var(--danger-soft); color:var(--danger); border:1px solid rgba(220,38,38,.25); }

.field{ margin-bottom:1.1rem; }
.field > label{ display:block; font-size:.82rem; font-weight:700; margin-bottom:.45rem; }
.field > label .opt{ font-weight:500; color:var(--muted); }
.input{ position:relative; }
.input > i.lead-ico{ position:absolute; left:1rem; top:50%; transform:translateY(-50%); color:var(--muted); font-size:.9rem; pointer-events:none; transition:color .18s; }
.input input{
  width:100%; padding:.9rem 2.8rem .9rem 2.8rem; border:1.5px solid var(--line); border-radius:14px;
  background:var(--bg); color:var(--ink); font:inherit; font-size:.92rem; transition:all .18s var(--ease);
}
.input input::placeholder{ color:color-mix(in srgb,var(--muted) 70%,transparent); }
.input input:focus{ outline:none; background:var(--card); border-color:var(--primary); box-shadow:0 0 0 4px var(--primary-soft); }
.input:focus-within > i.lead-ico{ color:var(--primary); }
.input .eye{ position:absolute; right:.45rem; top:50%; transform:translateY(-50%); width:38px; height:38px; border:0; border-radius:10px; background:transparent; color:var(--muted); cursor:pointer; }
.input .eye:hover{ color:var(--primary); background:var(--primary-soft); }
.hint{ font-size:.76rem; color:var(--muted); margin-top:.4rem; }
.hint b{ color:var(--primary); font-weight:700; }

.row{ display:flex; align-items:center; justify-content:space-between; gap:1rem; margin:.2rem 0 1.5rem; font-size:.85rem; }
.check{ display:flex; align-items:center; gap:.55rem; color:var(--muted); cursor:pointer; font-weight:600; }
.check input{ accent-color:var(--primary); width:17px; height:17px; }
.link{ color:var(--primary); font-weight:700; text-decoration:none; }
.link:hover{ text-decoration:underline; }

.btn{
  width:100%; display:flex; align-items:center; justify-content:center; gap:.6rem; padding:1rem 1.2rem; border:0; border-radius:14px;
  font:inherit; font-weight:700; font-size:.96rem; color:#fff; cursor:pointer;
  background:linear-gradient(135deg,var(--primary) 0%,var(--primary-2) 100%);
  box-shadow:0 14px 28px rgba(108,93,211,.35); transition:transform .18s var(--ease),box-shadow .18s var(--ease),opacity .18s;
}
.btn:hover{ transform:translateY(-2px); box-shadow:0 18px 34px rgba(108,93,211,.42); }
.btn:disabled{ opacity:.7; cursor:progress; transform:none; }
.btn.ghost{ background:transparent; color:var(--muted); box-shadow:none; border:1.5px solid var(--line); width:auto; padding:1rem 1.3rem; }
.btn.ghost:hover{ color:var(--primary); border-color:var(--primary); transform:none; box-shadow:none; }
.divider{ display:flex; align-items:center; gap:1rem; margin:1.6rem 0 1.2rem; color:var(--muted); font-size:.78rem; font-weight:600; }
.divider::before,.divider::after{ content:''; flex:1; height:1px; background:var(--line); }
.alt{ text-align:center; font-size:.9rem; color:var(--muted); }
.secure{ margin-top:1.4rem; text-align:center; font-size:.76rem; color:var(--muted); }
.secure i{ color:var(--ok); margin-right:.3rem; }

/* ---------- Wizard (register) ---------- */
.steps{ display:grid; grid-template-columns:1fr 1fr; gap:.6rem; margin-bottom:1.6rem; }
.step-pill{ display:flex; align-items:center; gap:.7rem; padding:.7rem .85rem; border-radius:14px; border:1.5px solid var(--line); color:var(--muted); font-size:.82rem; font-weight:700; transition:all .2s var(--ease); }
.step-pill .n{ width:28px; height:28px; border-radius:50%; display:grid; place-items:center; background:var(--bg); font-size:.78rem; font-weight:800; flex-shrink:0; }
.step-pill.active{ border-color:var(--primary); color:var(--ink); background:var(--primary-soft); }
.step-pill.active .n{ background:var(--primary); color:#fff; }
.step-pill.done .n{ background:var(--ok); color:#fff; }
.step{ display:none; } .step.show{ display:block; animation:stepIn .3s var(--ease); }
@keyframes stepIn{ from{ opacity:0; transform:translateX(12px);} to{ opacity:1; transform:none; } }
.actions{ display:flex; gap:.8rem; margin-top:1.4rem; }
.meter{ display:grid; grid-template-columns:repeat(4,1fr); gap:5px; margin-top:.6rem; }
.meter span{ height:5px; border-radius:99px; background:var(--line); transition:background .2s; }
.meter-text{ font-size:.74rem; font-weight:700; color:var(--muted); margin-top:.35rem; min-height:1.1em; display:flex; justify-content:space-between; }
.match.ok{ color:var(--ok); } .match.bad{ color:var(--danger); }

/* ---------- Brand side ---------- */
.brand-side{
  position:relative; overflow:hidden; color:#fff; padding:2.75rem 3rem; display:flex; flex-direction:column; justify-content:space-between; gap:2rem;
  background:
    radial-gradient(520px 340px at 90% 0%,rgba(245,181,68,.30),transparent 60%),
    radial-gradient(480px 380px at 0% 100%,rgba(138,125,255,.55),transparent 60%),
    linear-gradient(150deg,#2B1F7A 0%,#4B3BB3 50%,#6C5DD3 100%);
}
.brand-side::before{ content:''; position:absolute; inset:0; opacity:.5; pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);
  background-size:44px 44px; -webkit-mask-image:radial-gradient(circle at 70% 30%,#000 0%,transparent 70%); mask-image:radial-gradient(circle at 70% 30%,#000 0%,transparent 70%); }
.brand-side > *{ position:relative; z-index:1; }
.brand-top{ display:flex; align-items:center; gap:.8rem; }
.brand-top .logo{ width:46px; height:46px; border-radius:14px; display:grid; place-items:center; background:rgba(255,255,255,.18); backdrop-filter:blur(10px); font-size:1.15rem; border:1px solid rgba(255,255,255,.25); overflow:hidden; }
.brand-top .logo img{ width:100%; height:100%; object-fit:cover; }
.brand-top .nm{ font-weight:800; font-size:1.1rem; line-height:1.1; }
.brand-top .sb{ font-size:.74rem; opacity:.75; font-weight:500; }
.brand-copy h2{ font-size:2.35rem; font-weight:800; letter-spacing:-.035em; line-height:1.1; max-width:15ch; margin-bottom:1rem; }
.brand-copy p{ font-size:.98rem; line-height:1.65; color:rgba(255,255,255,.82); max-width:40ch; }

/* floating dashboard preview - the one memorable moment */
.preview{ width:100%; max-width:400px; padding:1.2rem 1.3rem; border-radius:22px; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.25); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); box-shadow:0 24px 50px rgba(10,6,50,.35); animation:float 7s ease-in-out infinite; }
@keyframes float{ 0%,100%{ transform:translateY(0) rotate(-1deg);} 50%{ transform:translateY(-10px) rotate(-1deg);} }
.preview-head{ display:flex; justify-content:space-between; align-items:center; font-size:.78rem; font-weight:700; margin-bottom:.9rem; }
.preview-head .tag{ background:rgba(255,255,255,.2); padding:.2rem .6rem; border-radius:99px; font-size:.68rem; }
.bars{ display:flex; align-items:flex-end; gap:8px; height:84px; }
.bars span{ flex:1; border-radius:8px 8px 4px 4px; background:rgba(255,255,255,.35); }
.bars span.hi{ background:var(--gold); }
.bar-labels{ display:flex; gap:8px; margin-top:.45rem; font-size:.66rem; opacity:.75; font-weight:600; }
.bar-labels span{ flex:1; text-align:center; }
.preview-foot{ display:flex; gap:1.2rem; margin-top:1rem; padding-top:.9rem; border-top:1px solid rgba(255,255,255,.2); font-size:.74rem; }
.preview-foot b{ display:block; font-size:1.05rem; }

.feats{ list-style:none; display:grid; gap:.85rem; }
.feats li{ display:flex; align-items:center; gap:.8rem; font-size:.9rem; font-weight:600; }
.feats i{ width:30px; height:30px; border-radius:10px; display:grid; place-items:center; background:rgba(255,255,255,.16); font-size:.8rem; }
.verse{ font-size:.92rem; font-style:italic; line-height:1.6; max-width:34ch; }
.verse small{ display:block; margin-top:.4rem; font-style:normal; font-weight:700; font-size:.72rem; letter-spacing:.04em; opacity:.8; }

@media (max-width:960px){
  .auth,.auth.reverse{ grid-template-columns:1fr; max-width:480px; min-height:0; border-radius:26px; }
  .brand-side{ display:none; }
  .form-side{ padding:2rem 1.6rem; max-height:none; }
}
@media (prefers-reduced-motion:reduce){ *{ animation:none !important; transition:none !important; } }
